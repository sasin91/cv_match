{
  "db_name": "SQLite",
  "query": "-- The job searches, newest first, each with how many posts it found (not counting dismissed\n-- ones) and how many of those are matched.\nSELECT\n  s.id,\n  s.name,\n  s.keywords,\n  s.location,\n  s.active,\n  s.paused_reason,\n  s.last_scanned_at,\n  COUNT(p.id) AS \"posts!: i64\",\n  COALESCE(SUM(p.status = 'matched'), 0) AS \"matched!: i64\"\nFROM job_searches s\nLEFT JOIN scanned_job_posts p ON p.job_search_id = s.id AND p.status <> 'dismissed'\nGROUP BY s.id\nORDER BY s.created_at DESC, s.id DESC\n",
