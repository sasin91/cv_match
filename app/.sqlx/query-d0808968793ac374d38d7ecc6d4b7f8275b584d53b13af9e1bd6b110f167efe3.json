  "query": "\n        SELECT d.id, d.kind, d.text, d.written_by, d.notes, d.written_at\n        FROM documents d\n        JOIN match_documents md ON md.document_id = d.id AND md.match_id = ?2\n        WHERE d.id = ?1 AND d.kind != ?3\n        ",
