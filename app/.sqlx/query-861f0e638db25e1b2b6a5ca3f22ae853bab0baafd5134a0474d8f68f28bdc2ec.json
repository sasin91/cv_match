{
  "db_name": "SQLite",
  "query": "-- One of the user's saved matches, with the CV it was matched with. ?1 the match, ?2 the user.\nSELECT\n  m.id,\n  m.trongate_user_id,\n  m.job_title,\n  m.company,\n  m.job_url,\n  m.job_text,\n  COALESCE(cv.name, '') AS \"cv_name!: String\",\n  COALESCE(cv.text, '') AS \"cv_text!: String\",\n  m.score,\n  m.points,\n  m.max_points,\n  m.tag,\n  m.rejected_at,\n  m.created_at,\n  m.deadline,\n  m.closed_at,\n  m.closed_why\nFROM matches m\nLEFT JOIN (\n  SELECT md.match_id, d.name, d.text\n  FROM match_documents md\n  JOIN documents d ON d.id = md.document_id AND d.kind = 'cv'\n) cv ON cv.match_id = m.id\nWHERE m.id = ?1 AND m.trongate_user_id IS ?2\n",
