{
  "manifest_version": 3,
  "name": "Joblog autofill, by Recruiter",
  "short_name": "Joblog autofill",
  "version": "0.4.0",
  "description": "Fills in Jobnet's \"Opret joblog\" form from a match you saved in Recruiter, PDFs included. Not made by Jobnet.",
  "key": "",
  "homepage_url": "https://recruiter.trongate.dev/joblog_extension",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*.jobnet.dk/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://recruiter.trongate.dev/*"],
      "js": ["recruiter.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "https://recruiter.trongate.dev/*", "https://cvrapi.dk/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "jobnet-joblog@recruiter.trongate.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  }
}
